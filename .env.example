# Fecha de referencia para evaluar la vigencia de los soportes (AAAA-MM-DD).
# Vacía = fecha local del sistema. Ejemplo para reproducir el escenario del PRD: 2026-09-03
FECHA_REFERENCIA=

# Clave del proveedor LLM (Anthropic). Solo vive en el entorno del backend; nunca en el repo, el front ni los logs.
ANTHROPIC_API_KEY=
# Modelo del agente (claude-haiku-5-5 para abaratar).
LLM_MODELO=claude-sonnet-5-5
# Tiempo máximo de espera por llamada al modelo, en milisegundos.
LLM_TIMEOUT_MS=60000
# Tope de iteraciones modelo → herramientas por turno (CA1).
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión (NFR3).
MAX_TOKENS_SESION=200000
# Puerto del API HTTP.
PORT=3000
